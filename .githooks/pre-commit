#!/usr/bin/env bash
#
# pre-commit hook for ABDSharedCode
#
# Auto-formats staged C++ source files (.h, .cpp) using clang-format,
# requiring clang-format version 18 or later.
#
# The .clang-format file at the repository root is the single source of
# truth for the formatting style.  This hook also validates that the
# .clang-format file itself is parseable.
#
# To bypass the hook for a single commit, use:
#   git commit --no-verify
#
# VERIFY_ONLY=1 runs in CI-check mode: scans ALL tracked .h/.cpp files (not just
# staged ones) and reports formatting violations with --dry-run --Werror, without
# modifying any files.  Used by the CI workflow to confirm the hook catches
# unformatted code.
#

set -euo pipefail

# ── 1. Locate clang-format ≥ 18 ─────────────────────────────────────────────

REQUIRED_MAJOR=18
CLANG_FORMAT=""

# If CLANG_FORMAT_OVERRIDE is set, use that binary directly (for CI or custom
# installs). Otherwise, search version-specific binaries first
# (clang-format-18), then the generic "clang-format" name. We prefer the
# newest available that meets the minimum.
if [ -n "${CLANG_FORMAT_OVERRIDE:-}" ]; then
    ver_line="$("$CLANG_FORMAT_OVERRIDE" --version 2>&1)"
    ver_major=$(echo "$ver_line" | sed -n 's/.*version \([0-9]\+\).*/\1/p')
    if [ -n "$ver_major" ] && [ "$ver_major" -ge "$REQUIRED_MAJOR" ]; then
        CLANG_FORMAT="$CLANG_FORMAT_OVERRIDE"
        CLANG_FORMAT_VER="$ver_line"
        echo "Using $CLANG_FORMAT ($ver_line)"
    fi
else
    for candidate in clang-format-20 clang-format-19 clang-format-18 clang-format-17 clang-format; do
        if command -v "$candidate" &>/dev/null; then
            ver_line="$("$candidate" --version 2>&1)"
            # Extract the major version number from output like:
            #   "Ubuntu clang-format version 18.1.3-..."
            #   "clang-format version 18.0.0"
            ver_major=$(echo "$ver_line" | sed -n 's/.*version \([0-9]\+\).*/\1/p')
            if [ -n "$ver_major" ] && [ "$ver_major" -ge "$REQUIRED_MAJOR" ]; then
                CLANG_FORMAT="$candidate"
                CLANG_FORMAT_VER="$ver_line"
                echo "Using $CLANG_FORMAT ($ver_line)"
                break
            fi
        fi
    done
fi

if [ -z "$CLANG_FORMAT" ]; then
    echo "✖  clang-format version ${REQUIRED_MAJOR}+ not found."
    echo ""
    echo "Install clang-format 18 or later:"
    echo "  Ubuntu/Debian: sudo apt install clang-format-18"
    echo "  macOS (Homebrew): brew install xcode-clang  (or: brew install llvm@18)"
    echo "  Windows (MSYS2):  pacman -S mingw-w64-x86_64-clang-format"
    echo "  Any (pip):        pip install clang-format==18.*"
    exit 1
fi

# ── 2. Validate .clang-format config ──────────────────────────────────────────

if [ ! -f ".clang-format" ]; then
    echo "✖  .clang-format not found in the repository root."
    echo "   The formatting configuration is required for this hook."
    exit 1
fi

# Parse the config to ensure it is valid.  --dump-config writes the effective
# configuration to stdout; if the file is invalid, clang-format exits non-zero.
if ! "$CLANG_FORMAT" --dump-config --style=file --assume-filename=.clang-format >/dev/null 2>&1; then
    echo "✖  .clang-format contains errors or uses an unsupported option."
    echo "   Run: $CLANG_FORMAT --dump-config --style=file --assume-filename=.clang-format"
    exit 1
fi

# ── 3. Collect C++ files to check ────────────────────────────────────────────

# In normal (commit) mode: only staged files are formatted and re-added.
# In VERIFY_ONLY mode (CI): all tracked .h/.cpp files are checked with
# --dry-run --Werror, no files are modified.

if [ "${VERIFY_ONLY:-0}" = "1" ]; then
    # CI / verify-only: check every tracked C++ source file.
    CPP_FILES=$(git ls-files '*.h' '*.cpp' || true)
    if [ -z "$CPP_FILES" ]; then
        echo "No C++ files found to check."
        exit 0
    fi
    echo "Verify-only mode: checking all tracked .h/.cpp files..."
    echo "Using $CLANG_FORMAT ($CLANG_FORMAT_VER)"
    echo ""

    EXIT_CODE=0
    while IFS= read -r file; do
        if [ -f "$file" ]; then
            if ! "$CLANG_FORMAT" --dry-run --Werror "$file" 2>&1; then
                EXIT_CODE=1
            fi
        fi
    done <<< "$CPP_FILES"

    if [ "$EXIT_CODE" -ne 0 ]; then
        echo ""
        echo "✖  Some files are not formatted according to .clang-format."
        echo "   Run: $CLANG_FORMAT -i <file> to fix, or bash .githooks/install.sh"
        exit 1
    fi

    echo "✓  All C++ files are properly formatted."
    exit 0
fi

STAGED_CPP=$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(h|cpp)$' || true)

if [ -z "$STAGED_CPP" ]; then
    echo "No staged C++ files to format."
    exit 0
fi

# ── 4. Format and re-stage ──────────────────────────────────────────────────

echo "Formatting staged C++ files with clang-format..."

for file in $STAGED_CPP; do
    if [ -f "$file" ]; then
        "$CLANG_FORMAT" -i "$file"
        git add "$file"
        echo "  formatted: $file"
    fi
done

echo "Done.  All formatted files have been re-added to the commit."
