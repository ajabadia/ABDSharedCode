  "license": "Proprietary",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^30.0.1",
    "serve": "^14.2.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
