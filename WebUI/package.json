{
  "name": "@abdsynths/scope",
  "version": "0.3.1",
  "description": "Universal lock-free audio visualizer and analysis engine for ABDSynths suite",
  "type": "module",
  "main": "./src/scope.js",
  "exports": {
    ".": "./src/scope.js",
    "./trigger": "./src/trigger.js",
    "./frame": "./src/frame.js",
    "./input/AnalyserInput": "./src/input/AnalyserInput.js",
    "./input/PushInput": "./src/input/PushInput.js",
    "./renderers/OscilloscopeRenderer": "./src/renderers/OscilloscopeRenderer.js",
    "./renderers/SpectrumRenderer": "./src/renderers/SpectrumRenderer.js",
    "./renderers/LissajousRenderer": "./src/renderers/LissajousRenderer.js",
    "./renderers/PhaseMeterRenderer": "./src/renderers/PhaseMeterRenderer.js",
    "./renderers/VuMeterRenderer": "./src/renderers/VuMeterRenderer.js",
    "./renderers/SpectrogramRenderer": "./src/renderers/SpectrogramRenderer.js",
    "./renderers/BaseRenderer": "./src/renderers/BaseRenderer.js",
    "./mount/EmbeddedMount": "./src/mount/EmbeddedMount.js",
    "./mount/FloatingMount": "./src/mount/FloatingMount.js",
    "./mount/MountBase": "./src/mount/MountBase.js",
    "./mount/LaneController": "./src/mount/LaneController.js",
    "./utils/exportImage": "./src/utils/exportImage.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
